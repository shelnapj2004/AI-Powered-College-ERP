# =============================================================================
# College ERP — Environment Variables
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Development (default): sqlite
DB_ENGINE=sqlite
# Production: mysql
# DB_ENGINE=mysql
# DB_NAME=college_erp
# DB_USER=college_erp_user
# DB_PASSWORD=your-secure-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- CORS (React Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Media & Static ---
MEDIA_URL=/media/
STATIC_URL=/static/

# --- API ---
API_VERSION=v1

# --- FastAPI AI Services ---
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
DJANGO_TO_AI_SERVICE_TIMEOUT_SECONDS=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
